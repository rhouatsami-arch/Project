@startuml MatiousHire_Classes_Methods
' MatiousHire PFE 2026 - Diagramme de classes COMPLET avec TOUTES les methodes
' Aligné sur app/ - Syntaxe PlantUML valide

top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam packageStyle rectangle

title MatiousHire - Diagramme de classes (methodes completes)

' ================================================================
' 1. DOMAINE - Entites avec methodes metier logiques
' ================================================================

package "1. Domaine metier" #E8F5E9 {

  abstract class Applicant {
    - id : UUID
    - email : String
    - technical_skills : Text
    - cv_extracted_text : Text
    - account_kind : String
    --
    + updateProfile()
    + uploadCv()
    + deleteCv()
    + getExtractedCv()
    + applyToJob()
    + saveJob()
    + unsaveJob()
    + getDashboard()
    + getRecommendations()
    + getApplications()
  }

  class Student
  class Candidate {
    + getLlmExplanation()
  }

  class Recruiter {
    - company_name : String
    --
    + publishJob()
    + updateJob()
    + deleteJob()
    + listCandidates()
    + shortlistCandidate()
    + rejectCandidate()
    + hireCandidate()
    + inviteInterview()
    + rankCandidates()
    + getDashboard()
    + manageSlots()
    + manageMeetings()
  }

  class Admin {
    + getDashboard()
    + listStudents()
    + listCandidates()
    + listRecruiters()
    + createStudent()
    + createCandidate()
    + createRecruiter()
    + deleteStudent()
    + deleteCandidate()
    + deleteRecruiter()
    + viewAuditLogs()
  }

  class Job {
    - title : String
    - required_skills : Text
    - status : JobStatus
  }

  class Application {
    - student_id : UUID
    - match_score : Integer
    - status : ApplicationStatus
  }

  class SavedJob
  class Meeting
  class InterviewSlot
  class CandidateAvailability
  class Notification
  class RecommendationHistory
  class AuditLog

  Applicant <|-- Student
  Applicant <|-- Candidate
}

' ================================================================
' 2. AUTHENTIFICATION
' ================================================================

package "2. Authentification (app/auth.py)" #FFEBEE {

  class AuthService <<utility>> {
    + {static} hash_password()
    + {static} verify_password()
    + {static} create_access_token()
    + {static} decode_token()
    + {static} get_current_student()
    + {static} get_current_candidate()
    + {static} get_current_recruiter()
    + {static} get_current_admin()
  }
}

' ================================================================
' 3. SERVICES UTILISATEURS ET OFFRES
' ================================================================

package "3. Services metier" #FFF3E0 {

  class UserService {
    + {static} update_student()
    + {static} update_recruiter()
    + {static} delete_student()
    + {static} delete_recruiter()
    + {static} create_student()
    + {static} create_recruiter()
  }

  class OfferService {
    + {static} list_open()
    + {static} get_open()
    + {static} list_for_recruiter()
    + {static} create()
    + {static} update()
    + {static} delete()
  }
}

' ================================================================
' 4. MODULE CV
' ================================================================

package "4. Module CV" #FFF9C4 {

  class CvService {
    + {static} upload()
    + {static} delete()
    + {static} get_extracted()
  }

  class CvStorage <<utility>> {
    + {static} validate_cv_file()
    + {static} save_cv_file()
    + {static} delete_cv_file()
  }

  class CvExtraction <<utility>> {
    + {static} extract_raw_text()
    + {static} normalize_text()
  }

  class CvSkills <<utility>> {
    + {static} extract_skills_from_text()
  }
}

' ================================================================
' 5. MODULE MATCHING IA
' ================================================================

package "5. Module Matching IA" #F3E5F5 {

  class MatchingService {
    + {static} profile_from_student()
    + {static} profile_from_job()
    + {static} score_student_job()
    + {static} safe_score_student_job()
    + {static} compatibility_score()
    + {static} recommend_jobs()
    + {static} record_recommendations()
    + {static} rank_applications()
  }

  class MatchingPipeline {
    + {static} stages()
    + {static} run()
    + {static} run_traced()
    + {static} rank_label()
  }

  class ScorerModule <<utility>> {
    + {static} compute_compatibility_score()
    + {static} compatibility_rank_label()
  }

  class MatchingScoreService <<utility>> {
    + {static} calculate_matching_score()
    + {static} matching_job_from_raw()
    + {static} get_matched_skills()
    + {static} get_missing_skills()
    + {static} compute_skills_score()
    + {static} compute_experience_score()
    + {static} compute_penalties()
  }

  class MatchingCandidate <<DTO>>
  class MatchingJob <<DTO>>
  class MatchingScoreResult <<DTO>>

  class ScoreFormula <<utility>> {
    + {static} parse_required_optional_skills()
    + {static} extract_experience_years()
    + {static} compute_skills_score()
    + {static} compute_experience_score()
    + {static} compute_semantic_similarity()
    + {static} compute_education_score()
    + {static} compute_location_score()
    + {static} compute_availability_score()
    + {static} compute_penalties()
    + {static} classify_score()
    + {static} precision_at_k()
    + {static} calculate_matching_score()
  }

  class NlpModule <<utility>> {
    + {static} normalize_text()
    + {static} tokenize()
    + {static} split_skill_tokens()
    + {static} jaccard_similarity()
    + {static} cosine_similarity_counts()
    + {static} tfidf_cosine_similarity()
    + {static} keyword_overlap_score()
  }

  class EmbeddingsModule <<utility>> {
    + {static} expand_skill_tokens()
    + {static} embedding_similarity()
  }

  class ApplicantProfile <<DTO>> {
    + technical_skills : String
    + cv_extracted_text : Text
  }

  class JobProfile <<DTO>> {
    + title : String
    + description : Text
  }

  class ScoreBreakdown <<DTO>> {
    + total_score() : Integer
  }

  class MatchResult <<DTO>> {
    + compatibility_score : Integer
    + rank_label : String
  }
}

' ================================================================
' 6. MODULE LLM
