    + list_meetings()
  }

  class CvRouter <<controller>> {
    + upload_cv()
    + get_cv_extracted_text()
    + download_cv()
    + delete_cv()
  }

  class AdminRouter <<controller>> {
    + dashboard()
    + list_users()
