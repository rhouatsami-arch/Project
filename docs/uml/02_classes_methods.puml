}

' ================================================================
' 9. INFRASTRUCTURE - Erreurs et persistance
' ================================================================

package "9. Infrastructure" #ECEFF1 {

  class AppError <<exception>> {
    + status_code : Integer
    + detail : String
  }

  class NotFoundError
  class ConflictError
  class ValidationError
  class UnauthorizedError
  class ForbiddenError
  class MatchingError

  AppError <|-- NotFoundError
  AppError <|-- ConflictError
  AppError <|-- ValidationError
  AppError <|-- UnauthorizedError
  AppError <|-- ForbiddenError
  AppError <|-- MatchingError

  class ErrorHandlers <<utility>> {
    + {static} register()
    + {static} handle_app_error()
    + {static} handle_http_exception()
    + {static} handle_validation_error()
    + {static} handle_integrity_error()
    + {static} handle_sqlalchemy_error()
    + {static} handle_value_error()
    + {static} handle_unexpected_error()
  }

  class Database <<utility>> {
    + {static} get_db()
    + {static} init_db()
  }
}

