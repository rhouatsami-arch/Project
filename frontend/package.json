{
  "name": "recruitment-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\"",
    "dev": "next dev --hostname 127.0.0.1",
    "dev:fresh": "npm run clean && next dev --hostname 127.0.0.1",
    "build": "npm run clean && next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "lucide-react": "^0.561.0",
    "next": "^15.5.22",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.5.22",
    "postcss": "^8.5.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "postcss": "^8.5.21",
    "sharp": "^0.35.0"
  }
}
