DATABASE_URL=postgresql://postgres@localhost:5432/recruitment_db
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_USE_COOKIES=true
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# OAuth 2.0 Authorization Code Flow (optional — enable per provider)
OAUTH_REDIRECT_BASE=http://127.0.0.1:8000/auth/oauth
FRONTEND_OAUTH_CALLBACK=http://127.0.0.1:3000/login/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Calendar (optional — uses GOOGLE_* credentials if unset)
# Enable Calendar API in Google Cloud Console and add redirect URI:
# http://127.0.0.1:8000/meetings/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_FRONTEND_REDIRECT=http://127.0.0.1:3000/recruiter/meetings
# Server-side demo token (optional alternative to recruiter OAuth connect)
GOOGLE_CALENDAR_REFRESH_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Enterprise SSO via OpenID Connect (Azure AD, Okta, Keycloak)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Enterprise SSO
OIDC_SCOPES=openid email profile

# Optional: if omitted, interview emails are printed to the server console.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=user@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=noreply@example.com
